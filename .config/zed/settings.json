// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"terminal": {
		"env": {
			// "SOBOLE_THEME_MODE": "\"dark\""
		},
		"shell": {
			"program": "zsh",
		},
	},
	"project_panel": {
		"auto_fold_dirs": false,
		"entry_spacing": "comfortable",
	},
	"status_bar": {
		"experimental.show": false,
	},
	"tab_bar": {
		"show": false,
	},
	"tabs": {
		"file_icons": false,
		"show_close_button": "hidden",
		"git_status": true,
	},
	"diagnostics": {
		"inline": {
			"enabled": false,
		},
	},
	"edit_predictions": {
		"disabled_globs": [".env", "*.lock", "package-lock.json"],
	},
	"current_line_highlight": "gutter", // "all", "none"
	"relative_line_numbers": "wrapped", // enabled, disabled
	"sticky_scroll": {
		"enabled": false,
	},
	"gutter": {
		"folds": true,
	},
	"minimap": {
		"show": "never",
	},
	"scrollbar": {
		"axes": {
			"horizontal": false,
			// "vertical": true
			"vertical": false,
		},
	},
	"hover_popover_enabled": false,
	"cursor_blink": false,
	"autosave": "on_focus_change",
	"buffer_font_fallbacks": [
		"Hack Nerd Font",
		"JetBrains Mono",
		// "Consolas",
		// "monospace"
	],
	"theme": {
		"mode": "dark",
		"light": "Ayu Light",
		"dark": "Pustota",
	},
	"icon_theme": {
		"mode": "light",
		"light": "VSCode Icons for Zed (Dark)",
		"dark": "VSCode Icons for Zed (Dark)",
	},
	"buffer_font_family": "Fira Code",
	"buffer_font_size": 19.0,
	"buffer_line_height": {"custom": 1.4},
	"buffer_font_weight": 300,
	"ui_font_family": ".SystemUIFont",
	"ui_font_size": 19,
	"colorize_brackets": true,
	"show_whitespaces": "selection",
	"wrap_guides": [80],
	"preferred_line_length": 80,
	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"vim_mode": true,
	"base_keymap": "VSCode",
	"code_lens": "off",
	"git": {
		"inline_blame": {
			"enabled": false,
		},
	},
	"languages": {
		"C": {
			"format_on_save": "on",
			"tab_size": 2,
		},
		"JavaScript": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "node_modules/.bin/prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
		"TypeScript": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "node_modules/.bin/prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
		"TSX": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "node_modules/.bin/prettier",
					"arguments": ["--stdin-filepath", "{buffer_path}"],
				},
			},
		},
		"JSON": {
			"format_on_save": "on",
		},
	},
	"agent": {
		"enabled": false,
		"button": false,
		"favorite_models": [],
		"model_parameters": [],
	},
}
